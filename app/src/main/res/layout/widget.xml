<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/Layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    android:theme="@style/AppTheme">

    <LinearLayout
        android:id="@+id/WidgetControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/WidgetTitleArea"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/WidgetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?android:textColorPrimary" />

            <ImageView
                android:id="@+id/WidgetNoteDropdown"
                android:layout_width="28dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/widget_note_dropdown"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/WidgetNewNote"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/take_note"
            android:src="@drawable/add" />

        <ImageButton
            android:id="@+id/WidgetOpenApp"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_open_notes_overview"
            android:src="@drawable/home" />

        <ImageButton
            android:id="@+id/ChangeNote"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/select_note"
            android:src="@drawable/document_scanner" />

        <ImageButton
            android:id="@+id/WidgetVoice"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_voice_plus"
            android:src="@drawable/record_audio" />

        <ImageButton
            android:id="@+id/WidgetDiscardRecording"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_discard_recording_title"
            android:src="@drawable/delete"
            android:visibility="gone" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/WidgetRecordingTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/recording"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/ListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@null"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/WidgetNotePicker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/WidgetNotePickerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:text="@string/select_note"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />


            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Only as tall as its notes, so that taps below reach the picker and close it -->
                <ListView
                    android:id="@+id/WidgetNoteChoices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="3dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />

                <TextView
                    android:id="@+id/WidgetNoNotes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/widget_no_notes"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:visibility="gone" />

            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/Empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/select_note"
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?android:textColorPrimary" />

    </FrameLayout>
</LinearLayout>
